---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BrowseSidebar from "../../components/BrowseSidebar.astro";
import { MISSING_LIVE_MAPS } from "../../data/live-game-registry.js";

export function getStaticPaths() {
  return MISSING_LIVE_MAPS.map((map) => ({ params: { slug: map.slug }, props: { map } }));
}

const { map } = Astro.props;
---

<Layout title={`${map.title} — OpenFront Wiki`} description={`${map.title} map reference from the current OpenFrontIO map registry.`}>
  <SiteHeader />
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[230px_minmax(0,1fr)]">
    <aside class="lg:sticky lg:top-20 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto" data-pagefind-ignore>
      <details open>
        <summary class="mb-3 flex cursor-pointer list-none items-center justify-between text-xs font-semibold uppercase tracking-widest text-cyan-glow lg:cursor-default">Browse Pages <span class="lg:hidden">▾</span></summary>
        <BrowseSidebar />
      </details>
    </aside>
    <main class="min-w-0">
      <nav class="mb-6 flex items-center gap-2 text-xs text-dawn/50" data-pagefind-ignore>
        <a href="/" class="hover:text-aquarius">Home</a><span>/</span><a href="/reference/live-registry" class="hover:text-aquarius">Live registry</a><span>/</span><span class="text-dawn">{map.title}</span>
      </nav>
      <header class="border-b border-white/10 pb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-cyan-glow">Current map registry</p>
        <h1 class="mt-2 font-display text-3xl font-bold tracking-wide text-white sm:text-4xl">{map.title}</h1>
        <div class="mt-4 flex flex-wrap gap-2">{map.categories.map((category) => <span class="rounded-full border border-white/10 bg-navy-700/60 px-2.5 py-1 text-xs text-dawn/80">{category}</span>)}</div>
      </header>
      <article class="wiki-content mt-6" data-pagefind-body>
        <p>This map is present in the live OpenFrontIO map registry but was not present in the wiki article manifest at the time of this audit.</p>
        <h2>Registry data</h2>
        <ul>
          <li><strong>Source ID:</strong> <code>{map.id}</code></li>
          <li><strong>Default nation count:</strong> {map.nations}</li>
          <li><strong>Registry categories:</strong> {map.categories.join(", ")}</li>
        </ul>
        <h2>Source</h2>
        <p><a href={map.source} target="_blank" rel="noopener noreferrer">OpenFrontIO Maps.gen.ts at the audited revision ↗</a></p>
      </article>
    </main>
  </div>
  <SiteFooter />
</Layout>